# Optional Microsoft public-client application for licensed Minecraft login.
MICROSOFT_CLIENT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:53682/callback

# Spotify public application ID. Register this exact callback in Spotify Dashboard.
# Desktop sign-in uses PKCE; a client secret is not required or included in builds.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:48128/spotify/callback

# Local launcher options.
JAVA_DOWNLOAD_URL=https://adoptium.net/temurin/releases/?version=21
