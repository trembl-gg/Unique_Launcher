<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UNIQUE LAUNCHER</AssemblyName>
    <RootNamespace>UniqueLauncher.WebView2</RootNamespace>
    <ApplicationIcon>..\unique иконка.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- WebView2 package also adds an unused WPF reference to WinForms projects. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>

<ItemGroup>
    <Content Include="node-backend.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="electron-shim.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\main.js" Link="main.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\lib\**\*" Link="lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\renderer\**\*" Link="renderer\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\unique иконка.ico" Link="launcher.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\game.ico" Link="game.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\unique.png" Link="unique.png" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
