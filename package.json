{
  "name": "minecraft-launcher",
  "version": "1.0.3",
  "description": "UNIQUE LAUNCHER with Microsoft and offline auth, custom builds and Modrinth integration",
  "author": "trembl_gg",
  "main": "main.js",
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test:spotify": "node scripts/check-spotify-auth.js",
    "test:release": "node scripts/check-release-1.3.js",
    "test": "node scripts/check-launcher-updates.js && node scripts/check-session-regressions.js && node scripts/check-launcher-services.js && node scripts/check-loader-preparation.js && node scripts/check-skin-metadata.js && node scripts/check-game-lifecycle.js && node scripts/check-icons.js && node scripts/check-localization-hardware.js && node scripts/check-game-storage.js && node scripts/check-instance-content.js && node scripts/check-stdio-transport.js && node scripts/check-auth-flows.js && node scripts/check-catalog-ui.js && node scripts/check-horizon.js && node scripts/check-horizon-instances.js && node scripts/check-spotify-auth.js && node scripts/check-release-1.3.js && node scripts/check-desktop-features.js && node scripts/check-memory.js && node scripts/check-discord-presence.js",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-rust.ps1",
    "start:legacy": "dotnet run --project webview2/UniqueLauncher.WebView2.csproj",
    "check:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-rust.ps1",
    "test:rust-ui": "node scripts/check-rust-ui.js",
    "test:interface": "node scripts/check-interface.js",
    "test:backend": "node scripts/check-backend-stdio.js && node scripts/check-auth-flows.js",
    "test:loaders": "node scripts/check-loader-preparation.js",
    "dist:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-rust.ps1",
    "start:webview2-backend": "node webview2/node-backend.js",
    "dist:webview2": "build-webview2.bat",
    "dist:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "dist": "npm run dist:installer",
    "release:local": "npm run dist:installer"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.1.0",
    "minecraft-launcher-core": "^2.6.0",
    "speakeasy": "^2.0.0"
  },
  "build": {
    "appId": "com.unique.launcher",
    "productName": "UNIQUE LAUNCHER",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "removePackageScripts": true,
    "afterPack": "build/afterPack.js",
    "files": [
      "**/*",
      "!**/.env",
      "!**/.env.*",
      "!dist/**",
      "!out/**",
      "!release/**",
      "!config/**",
      "!logs/**",
      "!*.log",
      "!*.html",
      "!temp_site.*",
      "!build-fabric-mod.bat",
      "!build-exe.bat",
      "!build-webview2.bat",
      "!hs_err_pid*.log",
      "!mods/**",
      "!bukkit-plugins/**",
      "!webview2/**",
      "!fabric-menu-mod/**",
      "!bukkit-music-status-plugin/**"
    ],
    "extraResources": [
      {
        "from": "mods",
        "to": "mods",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "bukkit-plugins",
        "to": "bukkit-plugins",
        "filter": [
          "*.jar"
        ]
      }
    ],
    "win": {
      "icon": "unique иконка.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "directories": {
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "generic",
        "url": ""
      }
    ]
  }
}
